{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/outil",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/outil/",
      "destination": "/",
      "permanent": false
    }
  ]
}